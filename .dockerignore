# .dockerignore for the commit-image build.
# Goal: bake in the FULL repo (including .git history — the grader uses it),
# dropping only local build artifacts and editor/OS cruft. Dev image, not minimal.

# ── Build outputs / local cruft ──────────────────────────────────────────────
# build.sh produces its outputs under /mayhem at build time; keep stale local
# build trees and fetched meson subprojects out of the context.
build/
build*/
mayhem-build/
mayhem-tests/
subprojects/stdplus/
subprojects/sdbusplus/
subprojects/libbej/
subprojects/nlohmann_json/
subprojects/phosphor-dbus-interfaces/
subprojects/stdexec/
subprojects/fmt/
subprojects/function2/
subprojects/googletest/
*.o
*.a
*.so
*.dylib
**/__pycache__/

# ── Editor / OS noise ────────────────────────────────────────────────────────
.DS_Store
*.swp
*~
